<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>13</LangVersion>
        <AssemblyName>TriggerHelper</AssemblyName>
        <RootNamespace>TriggerHelper</RootNamespace>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <PlatformTarget>x64</PlatformTarget>

        <ServerGarbageCollection>true</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
        <TieredCompilation>true</TieredCompilation>
        <TieredPGO>true</TieredPGO>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ModSharp.Sharp.Shared" Version="*" PrivateAssets="all" />
        <PackageReference Include="ModSharp.Sharp.Modules.AdminManager.Shared" Version="*" PrivateAssets="all" />
        <PackageReference Include="ModSharp.Sharp.Modules.CommandCenter.Shared" Version="*" PrivateAssets="all" />
        <PackageReference Include="Workleap.DotNet.CodingStandards" Version="*" PrivateAssets="all" />
        <PackageReference Include="stbychkov.AutoLoggerMessage" Version="*" PrivateAssets="all" />
    </ItemGroup>

</Project>
